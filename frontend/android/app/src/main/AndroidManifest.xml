<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          FCM's own status-bar icon when the app has no activity to hand it
          one (app closed / backgrounded). Reusing the launcher icon here
          works but renders as a plain white square in the status bar on
          Android 5+, which draws icons as a silhouette — a dedicated
          transparent/white notification icon would look better. Left as a
          follow-up rather than blocking push on having one ready.

          default_notification_channel_id is deliberately NOT set here: FCM
          silently drops a notification that names a channel the app never
          created, which is a much worse failure than the "Miscellaneous"
          channel Android falls back to without this meta-data.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ (API 33) requires this to even show the runtime
         permission prompt for notifications; without it, PushNotifications
         .requestPermissions() resolves as though the user had denied it,
         on every device newer than two years old at time of writing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Gate console photo capture.
         The camera is optional: a tablet without one must still install. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Required for <input type="file" capture="environment"> to reach the camera.

      From Android 11 (targetSdk 30+) an app cannot see other apps' activities
      unless it declares them here. Capacitor's file chooser calls
      resolveActivity() on ACTION_IMAGE_CAPTURE; without this block that call
      returns null, Capacitor logs "Media capture intent could not be launched"
      and silently falls back to the document picker. That is why "Take photo"
      opened Browse instead of the camera.
    -->
    <queries>
        <!--
          Android 11+ hides installed apps unless you declare what you need to
          see. Without this the UPI link resolves to nothing and the button
          appears broken - the same silent failure as an unhandled share intent.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>
</manifest>
