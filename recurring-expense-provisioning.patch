+  // vendor's own sub-ledger card) at month-end. Plain scalar, not a Prisma
+  // relation — same soft-link convention as JournalEntry.reference_id
+  // elsewhere (a FK constraint still exists at the DB level; see the migration).
+  provisioning_journal_entry_id String?  @db.Uuid
+
+  // Set once the real expense is recorded against the same recurring item in
+  // the same period and this provision is reversed/settled.
+  settled_expense_id            String?  @unique @db.Uuid
+  settlement_journal_entry_id   String?  @db.Uuid
+  settled_at                    DateTime? @db.Timestamptz
+
+  created_at DateTime @default(now()) @db.Timestamptz
+  updated_at DateTime @updatedAt @db.Timestamptz
+
+  @@unique([recurring_expense_id, period_year, period_month])
+  @@index([association_id, status])
+  @@map("expense_provisions")
+}
