// ─── Gate & Visitor Tables ────────────────────────────────────────────────────

model Visitor {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String        @db.Uuid
  association    Association   @relation(fields: [association_id], references: [id])
  unit_id        String        @db.Uuid
  unit           Unit          @relation(fields: [unit_id], references: [id])
  resident_id    String        @db.Uuid
  resident       User          @relation("ResidentApproval", fields: [resident_id], references: [id])
  visitor_name   String        @db.VarChar(255)
  visitor_phone  String?       @db.VarChar(20)
  purpose        String?       @db.VarChar(255)
  visit_type     VisitType
  status         VisitorStatus @default(PENDING)
  qr_token       String?       @unique @db.VarChar(64)
  expected_at    DateTime?     @db.Timestamptz
  entered_at     DateTime?     @db.Timestamptz
  exited_at      DateTime?     @db.Timestamptz
  vehicle_number String?       @db.VarChar(20)

  // Photo taken at the gate. Stored in-row like Document.file_data.
  // NEVER select photo_data in a list query — it is hundreds of KB per row.
  // Personal data: see scripts/purge-visitor-photos.sql for retention.
  photo_data        Bytes?
  photo_mime        String?         @db.VarChar(100)
  photo_captured_at DateTime?       @db.Timestamptz

  // Deliveries only. A parcel has its own lifecycle independent of whether the
  // courier set foot on the premises, so it is tracked separately from status.
  delivery_status   DeliveryStatus?
  delivery_provider String?         @db.VarChar(60)
  collected_at      DateTime?       @db.Timestamptz

  logged_by      String        @db.Uuid
  logger         User          @relation("LoggedBy", fields: [logged_by], references: [id])
  created_at     DateTime      @default(now()) @db.Timestamptz
  updated_at     DateTime      @updatedAt @db.Timestamptz

  @@index([unit_id])
  @@index([status])
  @@index([created_at])
  @@index([qr_token])
  @@index([visitor_name])
  @@index([association_id, delivery_status])
  @@map("visitors")
}

model FrequentVisitor {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id])
  unit_id        String      @db.Uuid
  unit           Unit        @relation(fields: [unit_id], references: [id])
  resident_id    String      @db.Uuid
  resident       User        @relation(fields: [resident_id], references: [id])
  name           String      @db.VarChar(255)
  phone          String?     @db.VarChar(20)
  role           String?     @db.VarChar(100)
  access_days    Json
  access_from    String      @db.VarChar(5)
  access_until   String      @db.VarChar(5)
  is_active      Boolean     @default(true)
  created_at     DateTime    @default(now()) @db.Timestamptz

  @@index([unit_id])
  @@index([is_active])
  @@map("frequent_visitors")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Nullable: a failed login can occur before we know the association/user.
  association_id String?      @db.Uuid
  association    Association? @relation(fields: [association_id], references: [id])

  entity_type    String       @db.VarChar(50)
  // Nullable: some events (e.g. LOGIN_FAILED, bulk GENERATE) have no single row id.
  entity_id      String?      @db.Uuid
  action         AuditAction

  performed_by   String?      @db.Uuid
  performer      User?        @relation(fields: [performed_by], references: [id])
  /// Free-text actor label for events with no user row (e.g. the phone that failed login).
  actor_label    String?      @db.VarChar(120)

  ip_address     String?      @db.VarChar(45)
  user_agent     String?      @db.VarChar(255)
  /// Short human-readable summary, e.g. "Closed FY 2025-26".
  summary        String?      @db.VarChar(255)

  old_value      Json?
  new_value      Json?
  created_at     DateTime     @default(now()) @db.Timestamptz

  @@index([entity_type, entity_id])
  @@index([performed_by])
  @@index([created_at])
  @@index([association_id, created_at])
  @@index([action])
  @@map("audit_logs")
}

// ─── System Configuration ─────────────────────────────────────────────────────

// ── Financial Accounting ─────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

enum BalanceType {
  DEBIT
  CREDIT
}

enum BPSide {
  RECEIVABLE
  PAYABLE
  BOTH
}

enum WhatsAppStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

/// Every WhatsApp message we attempted, and what became of it.
///
/// Kept because WhatsApp fails quietly. A template can be paused by Meta, a
/// number can hit its tier limit, a resident can block the sender — and none
/// of that surfaces anywhere unless it is written down. Without this table the
/// first sign of trouble is a committee asking why nobody got their bill.
///
/// It is also the only basis for charging an association for what they sent.
model WhatsAppMessage {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String         @db.Uuid
  association    Association    @relation(fields: [association_id], references: [id])
  /// Null for messages not tied to a person, e.g. a test send.
  user_id        String?        @db.Uuid
  user           User?          @relation("WhatsAppRecipient", fields: [user_id], references: [id])

  to_phone       String         @db.VarChar(20)
  template       String         @db.VarChar(100)
  /// What the template was filled with. Useful when a resident disputes what
  /// they were told, and when a template rejection needs reproducing.
  variables      Json?

  /// What this message was about, so a bill can show what was sent for it.
  reference_type String?        @db.VarChar(50)
  reference_id   String?        @db.Uuid

  status         WhatsAppStatus @default(QUEUED)
  /// Meta's message id, which is what delivery webhooks arrive against.
  wa_message_id  String?        @unique @db.VarChar(120)
  error_code     String?        @db.VarChar(40)
  error_message  String?        @db.Text

  sent_at        DateTime?      @db.Timestamptz
  delivered_at   DateTime?      @db.Timestamptz
  read_at        DateTime?      @db.Timestamptz
  failed_at      DateTime?      @db.Timestamptz

  created_at     DateTime       @default(now()) @db.Timestamptz
  updated_at     DateTime       @updatedAt @db.Timestamptz

  @@index([association_id, created_at])
  @@index([reference_type, reference_id])
  @@index([status])
  @@map("whatsapp_messages")
}

enum PaymentClaimStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// What a resident says they have paid, before anyone has checked.
///
/// Deliberately NOT a row in `payments`. A UPI deep link tells the app nothing
/// about whether the money moved — there is no callback, and the UPI app's own
/// response is not trustworthy. So a claim is a statement of intent, and only a
/// treasurer confirming against the bank turns it into a Payment with a journal
/// entry behind it.
///
/// Keeping the two tables apart is what stops a resident clearing their own
/// arrears, and stops the accounts showing money the bank never received.
model PaymentClaim {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String             @db.Uuid
  association    Association        @relation(fields: [association_id], references: [id])
  bill_id        String             @db.Uuid
  bill           Bill               @relation(fields: [bill_id], references: [id])
  unit_id        String             @db.Uuid
  unit           Unit               @relation(fields: [unit_id], references: [id])

  amount         Decimal            @db.Decimal(10, 2)
  /// The UTR / reference the UPI app showed the resident. Their evidence.
  upi_reference  String             @db.VarChar(50)
  /// The `tr` we put in the deep link, so a claim can be tied back to the
  /// exact link that was opened.
  intent_ref     String?            @db.VarChar(50)
  paid_on        DateTime           @db.Date

  status         PaymentClaimStatus @default(PENDING)
  claimed_by     String             @db.Uuid
  claimant       User               @relation("ClaimedBy", fields: [claimed_by], references: [id])
  claimed_at     DateTime           @default(now()) @db.Timestamptz

  reviewed_by    String?            @db.Uuid
  reviewer       User?              @relation("ClaimReviewedBy", fields: [reviewed_by], references: [id])
  reviewed_at    DateTime?          @db.Timestamptz
  /// Required when rejecting. A refusal with no reason is one the resident
  /// cannot act on, so they simply claim again.
  review_note    String?            @db.Text

  /// Set when confirmed. The claim keeps pointing at what it became.
  payment_id     String?            @unique @db.Uuid
  payment        Payment?           @relation(fields: [payment_id], references: [id])

  created_at     DateTime           @default(now()) @db.Timestamptz
  updated_at     DateTime           @updatedAt @db.Timestamptz

  @@index([association_id, status])
  @@index([bill_id])
  @@index([unit_id])
  @@map("payment_claims")
}

enum BPCategory {
  BANK
  VENDOR
  UNIT
}

enum VoucherType {
  RV  // Receipt Voucher   — money received
  PV  // Payment Voucher   — money paid out
  JV  // Journal Voucher   — adjustments / provisions
  BV  // Bank Voucher      — transactions involving a bank account
  CV  // Cash Voucher      — transactions involving a cash account
  DN  // Debit Note        — charge raised on a BP
  CN  // Credit Note       — credit issued to a BP
}

enum JournalEntrySource {
  AUTO    // system-generated (dues, expenses, payments)
  MANUAL  // treasurer-created
}

enum JournalStatus {
  DRAFT
  POSTED
  CANCELLED
}

// ── Vendor Service Type Master ────────────────────────────────────────────────

model ServiceType {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id], onDelete: Cascade)
  name           String      @db.VarChar(100)
  description    String?     @db.VarChar(255)
  is_active      Boolean     @default(true)
  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt @db.Timestamptz

  business_partners BusinessPartner[]

  @@unique([association_id, name])
  @@index([association_id])
  @@map("service_types")
}

// ── BP Type Master ────────────────────────────────────────────────────────────

model BPType {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id], onDelete: Cascade)
  name           String      @db.VarChar(100)
  side           BPSide
  is_active      Boolean     @default(true)
  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt @db.Timestamptz

  business_partners BusinessPartner[]
  accounts          Account[]

  @@unique([association_id, name])
  @@index([association_id])
  @@map("bp_types")
}

// ── Business Partner ──────────────────────────────────────────────────────────

model BusinessPartner {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id], onDelete: Cascade)
  code           String      @db.VarChar(20)
  name           String      @db.VarChar(255)
  bp_category    BPCategory                    // BANK | VENDOR | UNIT
  bp_type_id     String?     @db.Uuid          // optional GL control-account linkage
  bp_type        BPType?     @relation(fields: [bp_type_id], references: [id])

  // Bank-specific
  account_number String?     @db.VarChar(30)
  ifsc           String?     @db.VarChar(15)
  /// UPI address that credits THIS account, e.g. parkavenue@okhdfcbank.
  upi_vpa        String?     @db.VarChar(100)
  /// The name a resident sees in PhonePe/GPay when paying here. Often not the
  /// association's name: many small societies bank in a treasurer's individual
  /// name, and a payee name that does not match makes residents abandon the
  /// payment.
  upi_payee_name String?     @db.VarChar(100)

  // Vendor-specific
  gstin            String?      @db.VarChar(15)
  pan              String?      @db.VarChar(10)
  service_type_id  String?      @db.Uuid
  service_type     ServiceType? @relation(fields: [service_type_id], references: [id])

  // Unit-specific
  unit_id        String?     @db.Uuid
  unit           Unit?       @relation(fields: [unit_id], references: [id])

  // Common contact
  email          String?     @db.VarChar(255)
  phone          String?     @db.VarChar(20)

  // Opening balance (set here for sub-ledger BPs)
  opening_balance      Decimal?    @db.Decimal(15, 2)
  opening_balance_type BalanceType?
  opening_balance_date DateTime?   @db.Date

  is_active      Boolean     @default(true)
  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt @db.Timestamptz

  journal_lines  JournalLine[]
  upi_for_dues   DuesConfig[]  @relation("UpiCollectionAccount")

  @@unique([association_id, code])
  @@index([association_id])
  @@index([association_id, bp_category])
  @@index([association_id, bp_type_id])
  @@map("business_partners")
}

// ── Voucher Sequence ──────────────────────────────────────────────────────────
// Tracks the running counter per voucher type per financial year per association

model VoucherSequence {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id], onDelete: Cascade)
  voucher_type   VoucherType
  financial_year String      @db.VarChar(7)   // e.g. "2024-25"
  last_sequence  Int         @default(0)
  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt @db.Timestamptz

  @@unique([association_id, voucher_type, financial_year])
  @@map("voucher_sequences")
}

// ── Account (GL) ──────────────────────────────────────────────────────────────

model Account {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id       String       @db.Uuid
  code                 String       @db.VarChar(20)
  name                 String       @db.VarChar(120)
  type                 AccountType
  sub_type             String?      @db.VarChar(60)
  description          String?      @db.VarChar(255)

  // Hierarchy — group accounts roll up child accounts in reports
  parent_id            String?      @db.Uuid
  parent               Account?     @relation("AccountHierarchy", fields: [parent_id], references: [id])
  children             Account[]    @relation("AccountHierarchy")
  is_group             Boolean      @default(false)  // group accounts cannot have journal lines

  // Control account / sub-ledger linkage
  is_control_account   Boolean      @default(false)
  bp_type_id           String?      @db.Uuid         // required when is_control_account = true
  bp_type              BPType?      @relation(fields: [bp_type_id], references: [id])

  // Opening balance
  opening_balance      Decimal?     @db.Decimal(15, 2)
  opening_balance_type BalanceType?
  opening_balance_date DateTime?    @db.Date

  is_system            Boolean      @default(false)  // seeded accounts — cannot be deleted
  is_active            Boolean      @default(true)
  sort_order           Int          @default(0) @db.SmallInt
  created_at           DateTime     @default(now()) @db.Timestamptz
  updated_at           DateTime     @updatedAt @db.Timestamptz

  association          Association  @relation(fields: [association_id], references: [id], onDelete: Cascade)
  journal_lines        JournalLine[]

  @@unique([association_id, code])
  @@index([association_id, type])
  @@index([association_id, parent_id])
  @@map("accounts")
}

// ── Journal Entry ─────────────────────────────────────────────────────────────

model JournalEntry {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id      String             @db.Uuid
  reference_code      String             @db.VarChar(25)  // e.g. RV-2024-25-0001
  voucher_type        VoucherType
  financial_year      String             @db.VarChar(7)   // e.g. "2024-25"
  entry_date          DateTime           @db.Date
  narration           String             @db.VarChar(255)
  status              JournalStatus      @default(DRAFT)
  source              JournalEntrySource @default(MANUAL)

  // Link back to the originating transaction (dues, expense, payment etc.)
  reference_type      String?            @db.VarChar(50)
  reference_id        String?            @db.Uuid

  // Supporting document — invoice, receipt, bank slip. Stored in the row like
  // Document.file_data. NEVER select this in list queries; it is megabytes.
  file_data           Bytes?
  file_name           String?            @db.VarChar(255)
  mime_type           String?            @db.VarChar(100)

  // Workflow
  created_by_id       String?            @db.Uuid
  created_by          User?              @relation("JECreatedBy", fields: [created_by_id], references: [id])
  posted_by_id        String?            @db.Uuid
  posted_by           User?              @relation("JEPostedBy", fields: [posted_by_id], references: [id])
  posted_at           DateTime?          @db.Timestamptz
  cancelled_by_id     String?            @db.Uuid
  cancelled_by        User?              @relation("JECancelledBy", fields: [cancelled_by_id], references: [id])
  cancelled_at        DateTime?          @db.Timestamptz
  cancellation_reason String?            @db.Text

  created_at          DateTime           @default(now()) @db.Timestamptz
  updated_at          DateTime           @updatedAt @db.Timestamptz

  association         Association        @relation(fields: [association_id], references: [id], onDelete: Cascade)
  lines               JournalLine[]

  @@unique([association_id, reference_code])
  @@index([association_id, voucher_type])
  @@index([association_id, entry_date(sort: Desc)])
  @@index([association_id, financial_year])
  @@index([association_id, status])
  @@map("journal_entries")
}

// ── Journal Line ──────────────────────────────────────────────────────────────

model JournalLine {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journal_entry_id    String           @db.Uuid
  account_id          String           @db.Uuid
  business_partner_id String?          @db.Uuid  // required when account is a control account
  debit               Decimal          @default(0) @db.Decimal(15, 2)
  credit              Decimal          @default(0) @db.Decimal(15, 2)
  narration           String?          @db.VarChar(255)

  journal_entry       JournalEntry     @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade)
  account             Account          @relation(fields: [account_id], references: [id])
  business_partner    BusinessPartner? @relation(fields: [business_partner_id], references: [id])

  @@index([journal_entry_id])
  @@index([account_id])
  @@index([business_partner_id])
  @@map("journal_lines")
}

/// Web menu visibility, per association.
///
/// Sparse: a row exists only where an association departs from the default
/// role list declared on the item in NAV_GROUPS. Storing the full matrix would
/// freeze every association on today's defaults, so a menu item added in a
/// later release would stay invisible until someone enabled it by hand — for
/// each association separately.
model MenuGroupConfig {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id])
  group_id       String      @db.VarChar(50)
  role           String      @db.VarChar(50)
  enabled        Boolean     @default(true)
  updated_at     DateTime    @updatedAt @db.Timestamptz

  @@unique([association_id, group_id, role])
  @@index([association_id])
  @@map("menu_group_config")
}

model MobileConfig {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id        String      @unique @db.Uuid
  association           Association @relation(fields: [association_id], references: [id])

  // Feature flags — which screens appear in the mobile app
  feature_bills         Boolean     @default(true)
  feature_announcements Boolean     @default(true)
  feature_complaints    Boolean     @default(true)
  feature_visitors      Boolean     @default(true)

  // Accounting feature flags (Gold mobile only)
  feature_journal       Boolean     @default(true)
  feature_ledger        Boolean     @default(true)
  feature_pnl           Boolean     @default(true)
  feature_balance_sheet Boolean     @default(true)
  feature_coa           Boolean     @default(true)
  feature_fy_closure    Boolean     @default(true)

  // Push notification categories
  push_dues_reminder    Boolean     @default(true)
  push_announcements    Boolean     @default(true)
  push_visitor_alerts   Boolean     @default(true)

  // Login options
  login_mpin_enabled    Boolean     @default(true)
  login_biometric       Boolean     @default(false)
  login_otp_only        Boolean     @default(false)

  // Per-menu-item visibility + permissions (JSON map of itemId → {enabled, can_post})
  menu_items            Json?

  // Branding
  app_name              String?     @db.VarChar(100)
  theme_color           String?     @db.VarChar(7)
  logo_url              String?     @db.Text

  created_at            DateTime    @default(now()) @db.Timestamptz
  updated_at            DateTime    @updatedAt @db.Timestamptz

  @@map("mobile_config")
}

// ── Financial Year Closure ─────────────────────────────────────────────────────

model FinancialYearClose {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id     String      @db.Uuid
  association        Association @relation(fields: [association_id], references: [id], onDelete: Cascade)
  financial_year     String      @db.VarChar(7)   // e.g. "2024-25"
  status             String      @default("CLOSED") @db.VarChar(20)  // CLOSED | REOPENED
  net_surplus        Decimal     @db.Decimal(15, 2)
  closing_entry_id   String?     @db.VarChar(30)   // JE reference_code of closing entry (e.g. "JV-2025-26-0012")
  notes              String?     @db.Text
  closed_by_id       String?     @db.Uuid
  closed_by          User?       @relation("FYClosedBy", fields: [closed_by_id], references: [id])
  closed_at          DateTime    @default(now()) @db.Timestamptz
  reopened_by_id     String?     @db.Uuid
  reopened_by        User?       @relation("FYReopenedBy", fields: [reopened_by_id], references: [id])
  reopened_at        DateTime?   @db.Timestamptz

  @@unique([association_id, financial_year])
  @@map("financial_year_closes")
}

// ─── Module subscriptions ─────────────────────────────────────────────────────
//
// Which paid modules an association may use. This is ENTITLEMENT, and it is
// deliberately separate from MobileConfig and MenuGroupConfig, which are
// PREFERENCE — what an association chooses to show. Conflating the two would
// let an association toggle itself into a module it has not paid for.
//
// Core features (dues, receipts, maintenance, announcements, documents, polls,
// visitors) are never listed here. They are free for everyone and must not
// depend on a row existing.

enum ModuleKey {
  ACCOUNTING
  GOVERNANCE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
}

model AssociationModule {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String             @db.Uuid
  association    Association        @relation(fields: [association_id], references: [id], onDelete: Cascade)

  module         ModuleKey
  status         SubscriptionStatus @default(ACTIVE)

  starts_on      DateTime           @db.Date
  // NULL means perpetual — used for the reference association and for anyone
  // grandfathered in. Effective access is computed from this date at read
  // time, never from `status` alone, because a stored status goes stale the
  // moment a date passes with nobody looking.
  expires_on     DateTime?          @db.Date

  // For your own records. Invoicing happens outside the application.
  amount         Decimal?           @db.Decimal(12, 2)
  reference      String?            @db.VarChar(120)
  note           String?            @db.Text

  granted_by_id  String?            @db.Uuid
  granted_by     User?              @relation("ModuleGrantedBy", fields: [granted_by_id], references: [id])

  created_at     DateTime           @default(now()) @db.Timestamptz
  updated_at     DateTime           @updatedAt @db.Timestamptz

  @@unique([association_id, module])
  @@index([module, expires_on])
  @@map("association_modules")
}

// ─── Governance ───────────────────────────────────────────────────────────────
//
// Meetings, agendas, resolutions and minutes — the statutory side of running a
// registered association. Gated behind the GOVERNANCE module.
//
// Voting is one vote per FLAT, not per person: two owners of the same unit
// share a single vote, which is how apartment associations almost always work
// in practice. The unique constraints on unit_id are what enforce that, rather
// than application logic that can be forgotten.

enum MeetingType {
  AGM         // Annual General Meeting
  EGM         // Extraordinary General Meeting
  COMMITTEE   // Managing committee meeting
}

enum MeetingStatus {
  DRAFT           // being prepared; residents cannot see it
  NOTICE_ISSUED   // circulated; agenda is now fixed
  IN_PROGRESS     // being held
  CONCLUDED       // over; minutes may be published
  CANCELLED
}

enum RsvpStatus {
  YES
  NO
  MAYBE
}

enum ResolutionStatus {
  NOT_OPEN
  OPEN
  CLOSED
}

enum ResolutionOutcome {
  CARRIED
  DEFEATED
  WITHDRAWN
}

enum VoteChoice {
  FOR
  AGAINST
  ABSTAIN
}

/// Per-association rules. No jurisdiction is assumed — notice periods and
/// quorum differ by state and by an association's own bye-laws, so every
/// figure here is configurable rather than hardcoded to one act.
model GovernanceConfig {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @unique @db.Uuid
  association    Association @relation(fields: [association_id], references: [id], onDelete: Cascade)

  /// Minimum clear days between issuing notice and holding the meeting.
  notice_days           Int     @default(21) @db.SmallInt
  /// Percentage of eligible units that must attend for the meeting to be valid.
  quorum_percent        Decimal @default(33.33) @db.Decimal(5, 2)
  /// Reconvened meetings usually need a lower quorum, or none at all.
  adjourned_quorum_percent Decimal? @db.Decimal(5, 2)
  /// How long voting stays open after a meeting concludes, for members who
  /// attended but had not voted by the time it ended.
  voting_window_hours   Int     @default(24) @db.SmallInt

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  @@map("governance_config")
}

model Meeting {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String        @db.Uuid
  association    Association   @relation(fields: [association_id], references: [id], onDelete: Cascade)

  title          String        @db.VarChar(200)
  meeting_type   MeetingType
  status         MeetingStatus @default(DRAFT)

  /// NULL means a general body meeting of the whole association — an AGM or
  /// EGM, where every flat has a vote. Set means a sub-committee meeting,
  /// where the committee's members vote as individuals instead.
  committee_id   String?       @db.Uuid
  committee      Committee?    @relation(fields: [committee_id], references: [id], onDelete: SetNull)

  scheduled_at   DateTime      @db.Timestamptz
  venue          String?       @db.VarChar(300)
  online_link    String?       @db.VarChar(500)

  notice_body      String?     @db.Text
  notice_issued_at DateTime?   @db.Timestamptz

  /// Snapshotted when the notice is issued, NOT read live from
  /// GovernanceConfig. A meeting's validity is judged by the rules in force
  /// when it was called; changing the quorum setting next year must not
  /// retroactively invalidate a meeting held under the old one.
  quorum_percent Decimal?      @db.Decimal(5, 2)
  eligible_units Int?          @db.SmallInt

  concluded_at         DateTime? @db.Timestamptz
  minutes_body         String?   @db.Text
  minutes_published_at DateTime? @db.Timestamptz

  created_by_id String?      @db.Uuid
  created_by    User?        @relation("MeetingCreatedBy", fields: [created_by_id], references: [id])

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  agenda_items AgendaItem[]
  attendees    MeetingAttendee[]

  @@index([association_id, scheduled_at])
  @@index([association_id, status])
  @@map("meetings")
}

model AgendaItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meeting_id String  @db.Uuid
  meeting    Meeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade)

  seq         Int     @db.SmallInt
  title       String  @db.VarChar(300)
  description String? @db.Text

  /// Discussion items are minuted but not voted on.
  is_resolution Boolean          @default(false)
  voting_status ResolutionStatus @default(NOT_OPEN)
  /// A secret ballot hides attribution from the committee: only tallies are
  /// returned. The row still records which flat voted, because that is what
  /// stops a flat voting twice — so this is enforced discretion at the API,
  /// not cryptographic secrecy. Say so plainly to anyone who asks.
  is_secret     Boolean          @default(false)
  /// Share of votes cast (excluding abstentions) needed to carry. Ordinary
  /// resolutions are a simple majority; bye-law amendments and similar often
  /// require three quarters, so it is per item rather than per association.
  pass_threshold_percent Decimal @default(50.00) @db.Decimal(5, 2)

  voting_opened_at DateTime?          @db.Timestamptz
  voting_closed_at DateTime?          @db.Timestamptz
  outcome          ResolutionOutcome?

  votes ResolutionVote[]

  @@unique([meeting_id, seq])
  @@map("agenda_items")
}

model MeetingAttendee {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meeting_id String  @db.Uuid
  meeting    Meeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade)

  /// Set for a general body meeting, where attendance is counted in flats.
  /// NULL for a committee meeting, where it is counted in members.
  unit_id String? @db.Uuid
  unit    Unit?   @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  /// Who answered or turned up. For a committee meeting this IS the attendee.
  user_id String? @db.Uuid
  user    User?   @relation("MeetingAttendeeUser", fields: [user_id], references: [id])

  rsvp        RsvpStatus?
  attended    Boolean     @default(false)
  marked_at   DateTime?   @db.Timestamptz

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  /// One record per flat for a general body meeting. Postgres treats NULLs as
  /// distinct in a unique index, so committee rows (unit_id NULL) fall through
  /// to the constraint below instead of colliding with each other.
  @@unique([meeting_id, unit_id])
  /// One record per member for a committee meeting.
  @@unique([meeting_id, user_id])
  @@map("meeting_attendees")
}

model ResolutionVote {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agenda_item_id  String     @db.Uuid
  agenda_item     AgendaItem @relation(fields: [agenda_item_id], references: [id], onDelete: Cascade)

  /// Set when the vote belongs to a flat (general body). NULL when it belongs
  /// to a committee member voting as an individual.
  unit_id String? @db.Uuid
  unit    Unit?   @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  /// Who cast it. For a committee vote this is the voter of record.
  user_id String @db.Uuid
  user    User   @relation("ResolutionVoteUser", fields: [user_id], references: [id])

  choice  VoteChoice
  cast_at DateTime   @default(now()) @db.Timestamptz

  /// One vote per flat for a general body resolution. Two owners of the same
  /// unit cannot vote twice; the second attempt updates the row. Committee
  /// rows have unit_id NULL, and Postgres treats NULLs as distinct, so this
  /// constraint simply does not apply to them.
  @@unique([agenda_item_id, unit_id])
  /// One vote per person for a committee resolution. Harmlessly true of
  /// general body votes too, since each flat's vote has a single caster.
  @@unique([agenda_item_id, user_id])
  @@map("resolution_votes")
}

/// A sub-committee: finance, water and sewerage, maintenance, and so on.
///
/// Meetings of a sub-committee follow a different rule from general body
/// meetings. Quorum counts MEMBERS, and each member votes as an individual —
/// not one vote per flat. Two members who happen to live in the same flat get
/// a vote each, which is the whole point of appointing people rather than
/// households.
model Committee {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(120)
  description String? @db.Text
  is_active   Boolean @default(true)

  /// The built-in managing committee. Its roster is NOT stored as
  /// CommitteeMember rows — it is every active user with role = COMMITTEE,
  /// resolved at read time. One source of truth beats two that drift.
  is_managing Boolean @default(false)

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  members   CommitteeMember[]
  meetings  Meeting[]
  elections Election[]

  @@unique([association_id, name])
  @@map("committees")
}

model CommitteeMember {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  committee_id String    @db.Uuid
  committee    Committee @relation(fields: [committee_id], references: [id], onDelete: Cascade)

  user_id String @db.Uuid
  user    User   @relation("CommitteeMemberUser", fields: [user_id], references: [id], onDelete: Cascade)

  /// The convenor chairs and is the point of contact. Not enforced as unique —
  /// some committees genuinely have joint convenors.
  is_convenor Boolean @default(false)

  appointed_on DateTime  @default(now()) @db.Date
  /// Set when someone steps down. Past members are kept so historic quorum and
  /// vote records still make sense — a meeting held last year was quorate
  /// against the committee as it stood then.
  ended_on     DateTime? @db.Date

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  @@unique([committee_id, user_id])
  @@index([committee_id, ended_on])
  @@map("committee_members")
}

// ─── Register of members ──────────────────────────────────────────────────────
//
// A MEMBER IS NOT A USER. A user is a login; a member is the person holding
// membership rights in respect of a flat. The two overlap but neither implies
// the other:
//
//   - a joint holder or a nominee may never open the app;
//   - a tenant may hold an account and no membership;
//   - a member who sells stays on the register with a cessation date, because
//     a register that forgets former members is not a register.
//
// This is the statutory record. Once it exists it governs who votes at a
// general body meeting — the register is the authority, not the flat.

enum MembershipStatus {
  ACTIVE
  CEASED
}

model Membership {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id], onDelete: Cascade)

  unit_id String @db.Uuid
  unit    Unit   @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  /// Sequential per association, in order of admission. Allocated by the
  /// service under a transaction, not by a database sequence, because a
  /// sequence would leave gaps on any rolled-back insert and a register with
  /// unexplained gaps invites exactly the questions it exists to answer.
  member_no Int

  admitted_on      DateTime         @db.Date
  ceased_on        DateTime?        @db.Date
  cessation_reason String?          @db.VarChar(200)
  status           MembershipStatus @default(ACTIVE)

  /// Undivided share in the common property. Recorded now so share-weighted
  /// voting can be switched on later without revisiting every register.
  share_percent Decimal? @db.Decimal(7, 4)

  /// Sale deed, gift deed, succession certificate — whatever conferred it.
  deed_reference String? @db.VarChar(120)
  notes          String? @db.Text

  /// The membership this one succeeded, forming the chain of title for a flat.
  preceded_by_id String?     @db.Uuid
  preceded_by    Membership? @relation("MembershipChain", fields: [preceded_by_id], references: [id])
  succeeded_by   Membership[] @relation("MembershipChain")

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  holders  MembershipHolder[]
  nominees MembershipNominee[]

  @@unique([association_id, member_no])
  @@index([association_id, status])
  @@index([unit_id, status])
  @@map("memberships")
}

model MembershipHolder {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membership_id String     @db.Uuid
  membership    Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  /// Held as text, not a foreign key to User. Many holders never have an
  /// account, and the register must still name them.
  name  String  @db.VarChar(200)
  phone String? @db.VarChar(20)
  email String? @db.VarChar(255)

  /// Linked account, when there is one. This is what lets someone vote in the
  /// app; a holder without it votes in person and is marked present by the
  /// committee.
  user_id String? @db.Uuid
  user    User?   @relation("MembershipHolderUser", fields: [user_id], references: [id], onDelete: SetNull)

  /// Exactly one holder per membership carries the vote. Joint holders are
  /// members in full, but a flat still has one vote.
  is_primary Boolean @default(false)

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  @@index([membership_id])
  @@index([user_id])
  @@map("membership_holders")
}

model MembershipNominee {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membership_id String     @db.Uuid
  membership    Membership @relation(fields: [membership_id], references: [id], onDelete: Cascade)

  name         String  @db.VarChar(200)
  relationship String? @db.VarChar(60)
  /// Where a member nominates more than one person, in stated proportions.
  share_percent Decimal? @db.Decimal(7, 4)

  recorded_on DateTime @default(now()) @db.Date

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  @@index([membership_id])
  @@map("membership_nominees")
}

// ─── Committee elections ──────────────────────────────────────────────────────
//
// General seats, top N win. Nominations need a proposer and a seconder.
// Declaring the result replaces the committee roster.
//
// SECRECY IS STRUCTURAL HERE, unlike resolution voting. The choices live on an
// anonymous ballot paper; a separate voter roll records only that a flat has
// voted. Nothing in the schema links the two. A resolution can be an open
// vote and often should be; an election should not.

enum ElectionStatus {
  DRAFT
  NOMINATIONS_OPEN
  NOMINATIONS_CLOSED
  VOTING_OPEN
  VOTING_CLOSED
  DECLARED
  CANCELLED
}

enum NominationStatus {
  PROPOSED   // awaiting a seconder
  SECONDED   // awaiting the candidate's acceptance
  ACCEPTED   // standing
  WITHDRAWN  // stood down
  REJECTED   // ruled ineligible by the organiser
}

model Election {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id], onDelete: Cascade)

  /// Which committee is being elected.
  committee_id String    @db.Uuid
  committee    Committee @relation(fields: [committee_id], references: [id], onDelete: Cascade)

  title  String         @db.VarChar(200)
  seats  Int            @db.SmallInt
  status ElectionStatus @default(DRAFT)

  term_starts_on DateTime @db.Date
  term_ends_on   DateTime @db.Date

  nominations_close_at DateTime? @db.Timestamptz
  voting_closes_at     DateTime? @db.Timestamptz

  declared_at   DateTime? @db.Timestamptz
  declared_by_id String?  @db.Uuid
  declared_by    User?    @relation("ElectionDeclaredBy", fields: [declared_by_id], references: [id])

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  candidates ElectionCandidate[]
  ballots    ElectionBallot[]
  roll       ElectionVoterRoll[]

  @@index([association_id, status])
  @@map("elections")
}

model ElectionCandidate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  election_id String   @db.Uuid
  election    Election @relation(fields: [election_id], references: [id], onDelete: Cascade)

  /// The person standing. Must be a member of record when nominated —
  /// eligibility is checked against the register, not against having an
  /// account.
  user_id String @db.Uuid
  user    User   @relation("ElectionCandidateUser", fields: [user_id], references: [id], onDelete: Cascade)

  /// Their flat, captured at nomination so the ballot still reads correctly if
  /// they later move or transfer.
  unit_id String @db.Uuid
  unit    Unit   @relation(fields: [unit_id], references: [id])

  status    NominationStatus @default(PROPOSED)
  statement String?          @db.Text

  /// Two other members must back a nomination before it stands.
  proposed_by_unit_id String?  @db.Uuid
  seconded_by_unit_id String?  @db.Uuid
  seconded_at         DateTime? @db.Timestamptz
  accepted_at         DateTime? @db.Timestamptz

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  choices ElectionBallotChoice[]

  /// One nomination per person per election.
  @@unique([election_id, user_id])
  @@index([election_id, status])
  @@map("election_candidates")
}

/// An anonymous ballot paper. Deliberately carries NO reference to the voter.
model ElectionBallot {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  election_id String   @db.Uuid
  election    Election @relation(fields: [election_id], references: [id], onDelete: Cascade)

  cast_at DateTime @default(now()) @db.Timestamptz

  choices ElectionBallotChoice[]

  @@index([election_id])
  @@map("election_ballots")
}

model ElectionBallotChoice {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ballot_id String            @db.Uuid
  ballot    ElectionBallot    @relation(fields: [ballot_id], references: [id], onDelete: Cascade)

  candidate_id String            @db.Uuid
  candidate    ElectionCandidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  /// A ballot cannot name the same candidate twice.
  @@unique([ballot_id, candidate_id])
  @@index([candidate_id])
  @@map("election_ballot_choices")
}

/// Who has voted — and nothing about how. This is what stops a flat voting
/// twice while keeping the ballot itself anonymous.
model ElectionVoterRoll {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  election_id String   @db.Uuid
  election    Election @relation(fields: [election_id], references: [id], onDelete: Cascade)

  unit_id String @db.Uuid
  unit    Unit   @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  voted_at DateTime @default(now()) @db.Timestamptz

  @@unique([election_id, unit_id])
  @@map("election_voter_roll")
}

// ─── Compliance calendar ──────────────────────────────────────────────────────
//
// Statutory obligations with dates: the AGM window, the audit, the return, the
// lift certificate. An item recurs; each due date is an occurrence that is
// marked done separately, so last year's filing stays on the record.

enum ComplianceCategory {
  MEETING
  AUDIT
  FILING
  TAX
  INSURANCE
  LICENCE
  OTHER
}

enum Recurrence {
  NONE
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum ComplianceStatus {
  PENDING
  DONE
  WAIVED
}

model ComplianceItem {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id], onDelete: Cascade)

  title       String             @db.VarChar(200)
  description String?            @db.Text
  category    ComplianceCategory @default(OTHER)
  recurrence  Recurrence         @default(ANNUAL)

  /// Anchor for the due date. `due_month` is 1–12 and used by annual, half
  /// yearly and quarterly items; monthly items use only `due_day`.
  due_month Int? @db.SmallInt
  due_day   Int  @default(1) @db.SmallInt

  /// Who is answerable. Null means nobody has taken it on, which is worth
  /// seeing rather than hiding behind a default.
  owner_user_id String? @db.Uuid
  owner         User?   @relation("ComplianceOwner", fields: [owner_user_id], references: [id], onDelete: SetNull)

  remind_days_before Int     @default(14) @db.SmallInt
  is_active          Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  occurrences ComplianceOccurrence[]

  @@index([association_id, is_active])
  @@map("compliance_items")
}

model ComplianceOccurrence {
  id      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id String         @db.Uuid
  item    ComplianceItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  /// Denormalised so "what is overdue for this association" is one query
  /// rather than a join through items on every dashboard load.
  association_id String @db.Uuid

  due_on DateTime         @db.Date
  status ComplianceStatus @default(PENDING)

  completed_on    DateTime? @db.Date
  completed_by_id String?   @db.Uuid
  completed_by    User?     @relation("ComplianceCompletedBy", fields: [completed_by_id], references: [id])

  /// Acknowledgement number, receipt, certificate reference.
  reference String? @db.VarChar(160)
  notes     String? @db.Text

  /// Set when the owner has been told this is coming, so they are not told
  /// again every time the scheduler runs.
  reminded_at DateTime? @db.Timestamptz
  escalated_at DateTime? @db.Timestamptz

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  @@unique([item_id, due_on])
  @@index([association_id, status, due_on])
  @@map("compliance_occurrences")
}
