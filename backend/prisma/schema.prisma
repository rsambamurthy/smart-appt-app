// ─────────────────────────────────────────────────────────────────────────────
// SmartAppt — Prisma Schema
// PostgreSQL 15 · Prisma 5.x
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_USER
  MANAGER
  RESIDENT
  COMMITTEE
  TREASURER
  GATE_STAFF
}

enum OnboardingMode {
  INVITE_ONLY
  SELF_REGISTER_WITH_CODE
  OPEN
}

enum TicketCategory {
  PLUMBING
  ELECTRICAL
  CIVIL
  HOUSEKEEPING
  COMMON_AREA
  OTHERS
}

enum TicketPriority {
  EMERGENCY
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PenaltyType {
  FLAT
  PERCENTAGE
}

enum ChargeType {
  FIXED
  RATE_PER_SQFT
}


enum OneTimeDueStatus {
  DRAFT
  BILLS_GENERATED
  CLOSED
}

enum BillStatus {
  UNPAID
  PARTIAL
  PAID
  WAIVED
}

enum PaymentMode {
  ONLINE
  CASH
  CHEQUE
  BANK_TRANSFER
}

enum ExpensePaymentMode {
  CASH
  CHEQUE
  ONLINE
  UPI
}

enum ExpenseStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RECORDED
}

enum ExpenseFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum AnnouncementCategory {
  GENERAL
  URGENT
  EVENT
  MAINTENANCE
  MEETING
}

enum DocumentCategory {
  BYE_LAWS
  AGREEMENT
  INSURANCE
  MINUTES
  ANNUAL_REPORT
  OTHERS
}

enum PollType {
  YES_NO
  MCQ
}

enum VisitType {
  PRE_APPROVED
  WALK_IN
  DELIVERY
  FREQUENT
}

enum VisitorStatus {
  PENDING
  APPROVED
  DENIED
  ENTERED
  EXITED
  EXPIRED
}

// Where a parcel is. Independent of VisitorStatus, which describes the courier:
// a courier can leave (EXITED) while their parcel is still AT_GATE.
enum DeliveryStatus {
  AT_GATE     // held at the gate, waiting for the resident
  SENT_UP     // courier took it to the flat
  COLLECTED   // resident picked it up from the gate
  RETURNED    // went back with the courier
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  // Financial lifecycle
  CANCEL
  CLOSE
  REOPEN
  GENERATE
  ROLLBACK
  UPLOAD
  // Authentication / access
  LOGIN
  LOGIN_FAILED
  LOGOUT
  MPIN_SET
  MPIN_RESET
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ─── Core Tables ─────────────────────────────────────────────────────────────

model Association {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  address     String?  @db.Text
  city        String?  @db.VarChar(100)
  state       String?  @db.VarChar(100)
  pincode     String?  @db.VarChar(10)
  logo_s3_key String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  // Relations
  config             AssociationConfig?
  units              Unit[]
  users              User[]
  refresh_tokens     RefreshToken[]
  maintenance_tickets MaintenanceTicket[]
  ticket_attachments TicketAttachment[]
  ticket_status_logs TicketStatusLog[]
  dues_config        DuesConfig?
  bills              Bill[]
  bill_penalties     BillPenalty[]
  payment_claims     PaymentClaim[]
  whatsapp_messages  WhatsAppMessage[]
  menu_config        MenuGroupConfig[]
  payments           Payment[]
  expenses           Expense[]
  expense_budgets    ExpenseBudget[]
  expense_categories ExpenseCategoryConfig[]
  vendors            Vendor[]
  recurring_expenses RecurringExpense[]
  announcements      Announcement[]
  announcement_reads AnnouncementRead[]
  documents          Document[]
  polls              Poll[]
  poll_votes         PollVote[]
  visitors           Visitor[]
  frequent_visitors  FrequentVisitor[]
  audit_logs         AuditLog[]
  invites            UserInvite[]
  one_time_dues      OneTimeDue[]
  other_receipts     OtherReceipt[]
  accounts           Account[]
  journal_entries    JournalEntry[]
  bp_types           BPType[]
  service_types      ServiceType[]
  business_partners  BusinessPartner[]
  voucher_sequences   VoucherSequence[]
  mobile_config       MobileConfig?
  fy_closes           FinancialYearClose[]
  modules             AssociationModule[]
  governance_config   GovernanceConfig?
  meetings            Meeting[]
  committees          Committee[]
  memberships         Membership[]
  elections           Election[]
  compliance_items    ComplianceItem[]

  @@map("associations")
}

model AssociationConfig {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id            String         @unique @db.Uuid
  association               Association    @relation(fields: [association_id], references: [id])
  association_name          String         @db.VarChar(255)
  onboarding_mode           OnboardingMode @default(INVITE_ONLY)
  registration_unit_code    String?        @db.VarChar(50)
  require_manager_approval  Boolean        @default(true)
  invite_expiry_hours       Int            @default(48) @db.SmallInt
  invite_max_resends        Int            @default(3) @db.SmallInt
  otp_length                Int            @default(6) @db.SmallInt
  otp_ttl_seconds           Int            @default(300) @db.SmallInt
  otp_max_attempts          Int            @default(3) @db.SmallInt
  otp_lockout_minutes       Int            @default(15) @db.SmallInt
  otp_resend_cooldown_sec   Int            @default(60) @db.SmallInt
  session_idle_timeout_min  Int            @default(30) @db.SmallInt
  max_concurrent_sessions   Int            @default(5) @db.SmallInt
  expense_approval_threshold Decimal       @default(0) @db.Decimal(10, 2)
  financial_year_start_month Int           @default(4) @db.SmallInt  // 4 = April (Indian FY)
  created_at                DateTime       @default(now()) @db.Timestamptz
  updated_at                DateTime       @updatedAt @db.Timestamptz

  @@map("association_config")
}

model Unit {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id])
  flat_number    String      @db.VarChar(20)
  block          String?     @db.VarChar(20)
  floor          Int         @db.SmallInt
  area_sqft      Decimal?    @db.Decimal(8, 2)
  unit_type      String?     @db.VarChar(50)
  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt @db.Timestamptz
  deleted_at     DateTime?   @db.Timestamptz

  // Relations
  users               User[]
  maintenance_tickets MaintenanceTicket[]
  bills               Bill[]
  payments            Payment[]
  payment_claims      PaymentClaim[]
  visitors            Visitor[]
  frequent_visitors   FrequentVisitor[]
  business_partners   BusinessPartner[]
  meeting_attendees   MeetingAttendee[]
  resolution_votes    ResolutionVote[]
  memberships         Membership[]
  election_candidates ElectionCandidate[]
  election_roll       ElectionVoterRoll[]

  @@unique([association_id, flat_number])
  @@index([flat_number])
  @@map("units")
}

model User {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id])
  phone          String      @db.VarChar(20)
  email          String?     @db.VarChar(255)
  name           String      @db.VarChar(255)
  role           UserRole
  unit_id        String?     @db.Uuid
  unit           Unit?       @relation(fields: [unit_id], references: [id])
  is_owner       Boolean     @default(false)
  google_sub     String?     @db.VarChar(255)
  fcm_token      String?     @db.Text
  mpin_hash      String?     @db.Text
  move_in_date   DateTime?   @db.Date
  move_out_date  DateTime?   @db.Date
  is_active      Boolean     @default(true)
  /// WhatsApp is opt-in per person. Meta requires demonstrable consent, and a
  /// resident who never agreed must not be messaged just because the
  /// association enabled the feature.
  whatsapp_opt_in     Boolean   @default(false)
  whatsapp_opted_at   DateTime? @db.Timestamptz
  /// Only when it differs from the login phone. Most residents use one number.
  whatsapp_phone      String?   @db.VarChar(20)
  profile_photo_s3_key String? @db.Text
  vehicle_numbers String[]   @db.VarChar(20)
  notification_prefs Json?
  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt @db.Timestamptz
  deleted_at     DateTime?   @db.Timestamptz

  // Relations
  refresh_tokens      RefreshToken[]
  raised_tickets      MaintenanceTicket[] @relation("RaisedBy")
  assigned_tickets    MaintenanceTicket[] @relation("AssignedTo")
  ticket_status_logs  TicketStatusLog[]
  recorded_payments   Payment[]
  created_expenses    Expense[]           @relation("CreatedBy")
  approved_expenses   Expense[]           @relation("ApprovedBy")
  posted_announcements Announcement[]
  announcement_reads  AnnouncementRead[]
  uploaded_documents  Document[]
  created_polls       Poll[]
  poll_votes          PollVote[]
  pre_approved_visitors Visitor[]         @relation("ResidentApproval")
  logged_visitors     Visitor[]           @relation("LoggedBy")
  frequent_visitors   FrequentVisitor[]
  je_created          JournalEntry[]      @relation("JECreatedBy")
  je_posted           JournalEntry[]      @relation("JEPostedBy")
  je_cancelled        JournalEntry[]      @relation("JECancelledBy")
  fy_closed           FinancialYearClose[] @relation("FYClosedBy")
  fy_reopened         FinancialYearClose[] @relation("FYReopenedBy")
  modules_granted     AssociationModule[]  @relation("ModuleGrantedBy")
  meetings_created    Meeting[]            @relation("MeetingCreatedBy")
  meeting_attendance  MeetingAttendee[]    @relation("MeetingAttendeeUser")
  resolution_votes    ResolutionVote[]     @relation("ResolutionVoteUser")
  committee_seats     CommitteeMember[]    @relation("CommitteeMemberUser")
  membership_holdings MembershipHolder[]   @relation("MembershipHolderUser")
  elections_declared  Election[]           @relation("ElectionDeclaredBy")
  candidacies         ElectionCandidate[]  @relation("ElectionCandidateUser")
  compliance_owned    ComplianceItem[]     @relation("ComplianceOwner")
  penalties_charged   BillPenalty[]        @relation("PenaltyCharger")
  penalties_waived    BillPenalty[]        @relation("PenaltyWaiver")
  claims_made         PaymentClaim[]       @relation("ClaimedBy")
  claims_reviewed     PaymentClaim[]       @relation("ClaimReviewedBy")
  whatsapp_messages   WhatsAppMessage[]    @relation("WhatsAppRecipient")
  compliance_done     ComplianceOccurrence[] @relation("ComplianceCompletedBy")
  audit_logs          AuditLog[]
  invites_sent        UserInvite[]        @relation("InvitedBy")
  invite_received     UserInvite?         @relation("InvitedUser")
  dues_config_updated   DuesConfig[]
  expense_budgets       ExpenseBudget[]
  recurring_expenses    RecurringExpense[]
  vendors_created       Vendor[]
  one_time_dues_created OneTimeDue[] @relation("OneTimeDueCreator")
  other_receipts        OtherReceipt[]

  @@unique([association_id, phone])
  @@index([phone])
  @@index([email])
  @@index([unit_id])
  @@index([role])
  @@map("users")
}

model UserInvite {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String       @db.Uuid
  association    Association  @relation(fields: [association_id], references: [id])
  phone          String       @db.VarChar(20)
  email          String?      @db.VarChar(255)
  name           String?      @db.VarChar(255)
  role           UserRole
  unit_id        String?      @db.Uuid
  token          String       @unique @db.VarChar(64)
  status         InviteStatus @default(PENDING)
  resend_count   Int          @default(0) @db.SmallInt
  expires_at     DateTime     @db.Timestamptz
  invited_by     String       @db.Uuid
  inviter        User         @relation("InvitedBy", fields: [invited_by], references: [id])
  accepted_by    String?      @unique @db.Uuid
  invitee        User?        @relation("InvitedUser", fields: [accepted_by], references: [id])
  created_at     DateTime     @default(now()) @db.Timestamptz
  updated_at     DateTime     @updatedAt @db.Timestamptz

  @@index([token])
  @@index([phone])
  @@map("user_invites")
}

model RefreshToken {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id])
  user_id        String      @db.Uuid
  user           User        @relation(fields: [user_id], references: [id])
  token_hash     String      @db.VarChar(64)
  expires_at     DateTime    @db.Timestamptz
  revoked_at     DateTime?   @db.Timestamptz
  created_at     DateTime    @default(now()) @db.Timestamptz

  @@index([user_id])
  @@index([token_hash])
  @@map("refresh_tokens")
}

// ─── Maintenance Tables ───────────────────────────────────────────────────────

model MaintenanceTicket {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String         @db.Uuid
  association    Association    @relation(fields: [association_id], references: [id])
  // Optional — office-bearer roles (Manager, Treasurer) may not be linked to a unit
  unit_id        String?        @db.Uuid
  unit           Unit?          @relation(fields: [unit_id], references: [id])
  raised_by      String         @db.Uuid
  raiser         User           @relation("RaisedBy", fields: [raised_by], references: [id])
  category       TicketCategory
  priority       TicketPriority
  title          String         @db.VarChar(255)
  description    String         @db.Text
  status         TicketStatus   @default(SUBMITTED)
  assigned_to    String?        @db.Uuid
  assignee       User?          @relation("AssignedTo", fields: [assigned_to], references: [id])
  assigned_at    DateTime?      @db.Timestamptz
  sla_due_at     DateTime?      @db.Timestamptz
  sla_breached   Boolean        @default(false)
  resolved_at    DateTime?      @db.Timestamptz
  closed_at      DateTime?      @db.Timestamptz
  rating         Int?           @db.SmallInt
  rating_comment String?        @db.Text
  created_at     DateTime       @default(now()) @db.Timestamptz
  updated_at     DateTime       @updatedAt @db.Timestamptz

  attachments  TicketAttachment[]
  status_logs  TicketStatusLog[]

  @@index([unit_id])
  @@index([status])
  @@index([assigned_to])
  @@index([priority])
  @@index([created_at])
  @@map("maintenance_tickets")
}

model TicketAttachment {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String            @db.Uuid
  association    Association       @relation(fields: [association_id], references: [id])
  ticket_id      String            @db.Uuid
  ticket         MaintenanceTicket @relation(fields: [ticket_id], references: [id])
  s3_key         String            @db.Text
  mime_type      String            @db.VarChar(50)
  size_bytes     BigInt
  created_at     DateTime          @default(now()) @db.Timestamptz

  @@index([ticket_id])
  @@map("ticket_attachments")
}

model TicketStatusLog {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String            @db.Uuid
  association    Association       @relation(fields: [association_id], references: [id])
  ticket_id      String            @db.Uuid
  ticket         MaintenanceTicket @relation(fields: [ticket_id], references: [id])
  from_status    TicketStatus?
  to_status      TicketStatus
  changed_by     String            @db.Uuid
  changer        User              @relation(fields: [changed_by], references: [id])
  note           String?           @db.Text
  created_at     DateTime          @default(now()) @db.Timestamptz

  @@index([ticket_id])
  @@map("ticket_status_logs")
}

// ─── Financial Tables ─────────────────────────────────────────────────────────

model DuesConfig {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id      String      @unique @db.Uuid
  association         Association @relation(fields: [association_id], references: [id])
  charge_type         ChargeType  @default(FIXED)
  monthly_charge      Decimal     @db.Decimal(10, 2)
  rate_per_sqft       Decimal?    @db.Decimal(10, 4)
  due_day             Int         @db.SmallInt
  penalty_type        PenaltyType
  penalty_value       Decimal     @db.Decimal(10, 2)
  penalty_grace_days  Int         @db.SmallInt
  cash_balance        Decimal?    @db.Decimal(12, 2)
  cash_balance_as_on  DateTime?   @db.Date
  razorpay_key_id     String?
  razorpay_key_secret String?
  /// Which bank account collects UPI. The VPA and the payee name live on that
  /// bank record, not here — a UPI address belongs to one bank account, and
  /// the name residents see must match whoever actually holds it.
  upi_bank_bp_id      String?         @db.Uuid
  upi_bank            BusinessPartner? @relation("UpiCollectionAccount", fields: [upi_bank_bp_id], references: [id])
  auto_generate_bills Boolean     @default(false)
  auto_generate_day   Int         @default(1) @db.SmallInt
  updated_by          String      @db.Uuid
  updater             User        @relation(fields: [updated_by], references: [id])
  created_at          DateTime    @default(now()) @db.Timestamptz
  updated_at          DateTime    @updatedAt @db.Timestamptz

  @@map("dues_config")
}

model Bill {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id   String      @db.Uuid
  association      Association @relation(fields: [association_id], references: [id])
  unit_id          String      @db.Uuid
  unit             Unit        @relation(fields: [unit_id], references: [id])
  period_month     Int         @db.SmallInt
  period_year      Int         @db.SmallInt
  base_amount      Decimal     @db.Decimal(10, 2)
  penalty          Decimal     @default(0) @db.Decimal(10, 2)
  levy_amount      Decimal     @default(0) @db.Decimal(10, 2)
  total_amount     Decimal     @db.Decimal(10, 2)
  due_date         DateTime    @db.Date
  status           BillStatus  @default(UNPAID)
  // One-time due link (null = regular monthly bill)
  one_time_due_id  String?     @db.Uuid
  one_time_due     OneTimeDue? @relation(fields: [one_time_due_id], references: [id])
  bill_label       String?     @db.VarChar(255)
  created_at       DateTime    @default(now()) @db.Timestamptz
  updated_at       DateTime    @updatedAt @db.Timestamptz

  payments  Payment[]
  penalties BillPenalty[]
  claims    PaymentClaim[]

  @@unique([unit_id, period_month, period_year, one_time_due_id])
  @@index([unit_id])
  @@index([status])
  @@index([due_date])
  @@index([one_time_due_id])
  @@map("bills")
}

/// A late-payment penalty charged on one bill.
///
/// `bills.penalty` is the denormalised live total; this table is the history.
/// A waiver never deletes the row and never edits the amount — it stamps
/// `waived_at`, so the charge and its reversal both remain visible. An auditor
/// asking "was this ever penalised?" gets a truthful answer either way.
///
/// A partial unique index keeps at most one un-waived penalty per bill, which
/// is what makes "once per bill" an invariant rather than a convention.
model BillPenalty {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id])
  bill_id        String      @db.Uuid
  bill           Bill        @relation(fields: [bill_id], references: [id])

  amount         Decimal     @db.Decimal(10, 2)
  /// How the amount was arrived at, kept so a resident can be shown the
  /// working even after the config has changed.
  penalty_type   PenaltyType
  penalty_value  Decimal     @db.Decimal(10, 2)
  grace_days     Int         @db.SmallInt
  /// Days past due when the penalty was applied.
  days_overdue   Int         @db.SmallInt

  /// The date the charge belongs to in the ledger, not when the row was made.
  charged_on     DateTime    @db.Date
  charged_by     String      @db.Uuid
  charger        User        @relation("PenaltyCharger", fields: [charged_by], references: [id])

  waived_at      DateTime?   @db.Timestamptz
  waived_by      String?     @db.Uuid
  waiver         User?       @relation("PenaltyWaiver", fields: [waived_by], references: [id])
  /// Mandatory in the service. A waiver with no reason is the entry an
  /// incoming committee will ask about first.
  waive_reason   String?     @db.Text

  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt @db.Timestamptz

  @@index([bill_id])
  @@index([association_id, charged_on])
  @@map("bill_penalties")
}

model OneTimeDue {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String           @db.Uuid
  association    Association      @relation(fields: [association_id], references: [id])
  title          String           @db.VarChar(255)
  description    String?          @db.Text
  charge_type    ChargeType       @default(FIXED)
  amount         Decimal          @db.Decimal(10, 2)
  due_date       DateTime         @db.Date
  status          OneTimeDueStatus @default(DRAFT)
  bills_count     Int              @default(0)
  target_unit_ids String[]
  created_by      String           @db.Uuid
  creator         User             @relation("OneTimeDueCreator", fields: [created_by], references: [id])
  bills          Bill[]
  created_at     DateTime         @default(now()) @db.Timestamptz
  updated_at     DateTime         @updatedAt @db.Timestamptz

  @@index([association_id])
  @@map("one_time_dues")
}

model Payment {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id   String      @db.Uuid
  association      Association @relation(fields: [association_id], references: [id])
  bill_id          String      @db.Uuid
  bill             Bill        @relation(fields: [bill_id], references: [id])
  unit_id          String      @db.Uuid
  unit             Unit        @relation(fields: [unit_id], references: [id])
  amount           Decimal     @db.Decimal(10, 2)
  payment_mode     PaymentMode
  payment_date     DateTime    @db.Timestamptz
  gateway          String?     @db.VarChar(50)
  gateway_order_id String?     @db.VarChar(100)
  gateway_txn_id   String?     @unique @db.VarChar(100)
  reference_no     String?     @db.VarChar(100)
  recorded_by      String?     @db.Uuid
  recorder         User?       @relation(fields: [recorded_by], references: [id])
  receipt_s3_key   String?     @db.Text
  created_at       DateTime    @default(now()) @db.Timestamptz

  claim            PaymentClaim?

  @@index([bill_id])
  @@index([unit_id])
  @@index([payment_date])
  @@map("payments")
}

model OtherReceipt {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id])
  receipt_date   DateTime    @db.Date
  amount         Decimal     @db.Decimal(10, 2)
  category       String      @db.VarChar(100)
  description    String?     @db.Text
  received_from  String?     @db.VarChar(255)
  payment_mode   PaymentMode
  recorded_by    String      @db.Uuid
  recorder       User        @relation(fields: [recorded_by], references: [id])
  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt @db.Timestamptz
  deleted_at     DateTime?   @db.Timestamptz

  @@index([association_id])
  @@index([receipt_date])
  @@map("other_receipts")
}

model Vendor {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id])
  name           String      @db.VarChar(255)
  service_type   String?     @db.VarChar(100)
  phone          String?     @db.VarChar(20)
  email          String?     @db.VarChar(255)
  bank_name      String?     @db.VarChar(100)
  account_no_enc String?     @db.Text
  ifsc           String?     @db.VarChar(20)
  is_active      Boolean     @default(true)
  created_by     String      @db.Uuid
  creator        User        @relation(fields: [created_by], references: [id])
  created_at     DateTime    @default(now()) @db.Timestamptz

  expenses           Expense[]
  recurring_expenses RecurringExpense[]

  @@index([name])
  @@index([service_type])
  @@map("vendors")
}

model Expense {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id  String             @db.Uuid
  association     Association        @relation(fields: [association_id], references: [id])
  expense_date    DateTime           @db.Date
  category        String          @db.VarChar(100)
  vendor_id       String?            @db.Uuid
  vendor          Vendor?            @relation(fields: [vendor_id], references: [id])
  vendor_name     String?            @db.VarChar(255)
  amount          Decimal            @db.Decimal(10, 2)
  payment_mode    ExpensePaymentMode
  description     String?            @db.Text
  invoice_s3_key  String?            @db.Text
  status          ExpenseStatus      @default(PENDING_APPROVAL)
  approved_by     String?            @db.Uuid
  approver        User?              @relation("ApprovedBy", fields: [approved_by], references: [id])
  approved_at     DateTime?          @db.Timestamptz
  approval_note   String?            @db.Text
  is_recurring    Boolean            @default(false)
  recurring_id    String?            @db.Uuid
  recurring       RecurringExpense?  @relation(fields: [recurring_id], references: [id])
  created_by      String             @db.Uuid
  creator         User               @relation("CreatedBy", fields: [created_by], references: [id])
  created_at      DateTime           @default(now()) @db.Timestamptz
  updated_at      DateTime           @updatedAt @db.Timestamptz
  deleted_at      DateTime?          @db.Timestamptz

  @@index([expense_date])
  @@index([category])
  @@index([status])
  @@index([vendor_id])
  @@index([created_by])
  @@map("expenses")
}

model ExpenseBudget {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String          @db.Uuid
  association    Association     @relation(fields: [association_id], references: [id])
  category       String         @db.VarChar(100)
  financial_year Int             @db.SmallInt
  budget_amount  Decimal         @db.Decimal(10, 2)
  updated_by     String          @db.Uuid
  updater        User            @relation(fields: [updated_by], references: [id])
  created_at     DateTime        @default(now()) @db.Timestamptz
  updated_at     DateTime        @updatedAt @db.Timestamptz

  @@unique([association_id, category, financial_year])
  @@map("expense_budgets")
}

model ExpenseCategoryConfig {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id])
  name           String      @db.VarChar(100)
  display_name   String      @db.VarChar(100)
  color          String?     @db.VarChar(20)
  is_active      Boolean     @default(true)
  sort_order     Int         @default(0) @db.SmallInt
  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt @db.Timestamptz

