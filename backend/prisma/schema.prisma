// ─── Gate & Visitor Tables ────────────────────────────────────────────────────

model Visitor {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String        @db.Uuid
  association    Association   @relation(fields: [association_id], references: [id])
  unit_id        String        @db.Uuid
  unit           Unit          @relation(fields: [unit_id], references: [id])
  resident_id    String        @db.Uuid
  resident       User          @relation("ResidentApproval", fields: [resident_id], references: [id])
  visitor_name   String        @db.VarChar(255)
  visitor_phone  String?       @db.VarChar(20)
  purpose        String?       @db.VarChar(255)
  visit_type     VisitType
  status         VisitorStatus @default(PENDING)
  qr_token       String?       @unique @db.VarChar(64)
  expected_at    DateTime?     @db.Timestamptz
  entered_at     DateTime?     @db.Timestamptz
  exited_at      DateTime?     @db.Timestamptz
  vehicle_number String?       @db.VarChar(20)
  logged_by      String        @db.Uuid
  logger         User          @relation("LoggedBy", fields: [logged_by], references: [id])
  created_at     DateTime      @default(now()) @db.Timestamptz
  updated_at     DateTime      @updatedAt @db.Timestamptz

  @@index([unit_id])
  @@index([status])
  @@index([created_at])
  @@index([qr_token])
  @@index([visitor_name])
  @@map("visitors")
}

model FrequentVisitor {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id])
  unit_id        String      @db.Uuid
  unit           Unit        @relation(fields: [unit_id], references: [id])
  resident_id    String      @db.Uuid
  resident       User        @relation(fields: [resident_id], references: [id])
  name           String      @db.VarChar(255)
  phone          String?     @db.VarChar(20)
  role           String?     @db.VarChar(100)
  access_days    Json
  access_from    String      @db.VarChar(5)
  access_until   String      @db.VarChar(5)
  is_active      Boolean     @default(true)
  created_at     DateTime    @default(now()) @db.Timestamptz

  @@index([unit_id])
  @@index([is_active])
  @@map("frequent_visitors")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Nullable: a failed login can occur before we know the association/user.
  association_id String?      @db.Uuid
  association    Association? @relation(fields: [association_id], references: [id])

  entity_type    String       @db.VarChar(50)
  // Nullable: some events (e.g. LOGIN_FAILED, bulk GENERATE) have no single row id.
  entity_id      String?      @db.Uuid
  action         AuditAction

  performed_by   String?      @db.Uuid
  performer      User?        @relation(fields: [performed_by], references: [id])
  /// Free-text actor label for events with no user row (e.g. the phone that failed login).
  actor_label    String?      @db.VarChar(120)

  ip_address     String?      @db.VarChar(45)
  user_agent     String?      @db.VarChar(255)
  /// Short human-readable summary, e.g. "Closed FY 2025-26".
  summary        String?      @db.VarChar(255)

  old_value      Json?
  new_value      Json?
  created_at     DateTime     @default(now()) @db.Timestamptz

  @@index([entity_type, entity_id])
  @@index([performed_by])
  @@index([created_at])
  @@index([association_id, created_at])
  @@index([action])
  @@map("audit_logs")
}

// ─── System Configuration ─────────────────────────────────────────────────────

// ── Financial Accounting ─────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

enum BalanceType {
  DEBIT
  CREDIT
}

enum BPSide {
  RECEIVABLE
  PAYABLE
  BOTH
}

enum BPCategory {
  BANK
  VENDOR
  UNIT
}

enum VoucherType {
  RV  // Receipt Voucher   — money received
  PV  // Payment Voucher   — money paid out
  JV  // Journal Voucher   — adjustments / provisions
  BV  // Bank Voucher      — transactions involving a bank account
  CV  // Cash Voucher      — transactions involving a cash account
  DN  // Debit Note        — charge raised on a BP
  CN  // Credit Note       — credit issued to a BP
}

enum JournalEntrySource {
  AUTO    // system-generated (dues, expenses, payments)
  MANUAL  // treasurer-created
}

enum JournalStatus {
  DRAFT
  POSTED
  CANCELLED
}

// ── Vendor Service Type Master ────────────────────────────────────────────────

model ServiceType {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id], onDelete: Cascade)
  name           String      @db.VarChar(100)
  description    String?     @db.VarChar(255)
  is_active      Boolean     @default(true)
  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt @db.Timestamptz

  business_partners BusinessPartner[]

  @@unique([association_id, name])
  @@index([association_id])
  @@map("service_types")
}

// ── BP Type Master ────────────────────────────────────────────────────────────

model BPType {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id], onDelete: Cascade)
  name           String      @db.VarChar(100)
  side           BPSide
  is_active      Boolean     @default(true)
  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt @db.Timestamptz

  business_partners BusinessPartner[]
  accounts          Account[]

  @@unique([association_id, name])
  @@index([association_id])
  @@map("bp_types")
}

// ── Business Partner ──────────────────────────────────────────────────────────

model BusinessPartner {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id], onDelete: Cascade)
  code           String      @db.VarChar(20)
  name           String      @db.VarChar(255)
  bp_category    BPCategory                    // BANK | VENDOR | UNIT
  bp_type_id     String?     @db.Uuid          // optional GL control-account linkage
  bp_type        BPType?     @relation(fields: [bp_type_id], references: [id])

  // Bank-specific
  account_number String?     @db.VarChar(30)
  ifsc           String?     @db.VarChar(15)

  // Vendor-specific
  gstin            String?      @db.VarChar(15)
  pan              String?      @db.VarChar(10)
  service_type_id  String?      @db.Uuid
  service_type     ServiceType? @relation(fields: [service_type_id], references: [id])

  // Unit-specific
  unit_id        String?     @db.Uuid
  unit           Unit?       @relation(fields: [unit_id], references: [id])

  // Common contact
  email          String?     @db.VarChar(255)
  phone          String?     @db.VarChar(20)

  // Opening balance (set here for sub-ledger BPs)
  opening_balance      Decimal?    @db.Decimal(15, 2)
  opening_balance_type BalanceType?
  opening_balance_date DateTime?   @db.Date

  is_active      Boolean     @default(true)
  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt @db.Timestamptz

  journal_lines  JournalLine[]

  @@unique([association_id, code])
  @@index([association_id])
  @@index([association_id, bp_category])
  @@index([association_id, bp_type_id])
  @@map("business_partners")
}

// ── Voucher Sequence ──────────────────────────────────────────────────────────
// Tracks the running counter per voucher type per financial year per association

model VoucherSequence {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id String      @db.Uuid
  association    Association @relation(fields: [association_id], references: [id], onDelete: Cascade)
  voucher_type   VoucherType
  financial_year String      @db.VarChar(7)   // e.g. "2024-25"
  last_sequence  Int         @default(0)
  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt @db.Timestamptz

  @@unique([association_id, voucher_type, financial_year])
  @@map("voucher_sequences")
}

// ── Account (GL) ──────────────────────────────────────────────────────────────

model Account {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id       String       @db.Uuid
  code                 String       @db.VarChar(20)
  name                 String       @db.VarChar(120)
  type                 AccountType
  sub_type             String?      @db.VarChar(60)
  description          String?      @db.VarChar(255)

  // Hierarchy — group accounts roll up child accounts in reports
  parent_id            String?      @db.Uuid
  parent               Account?     @relation("AccountHierarchy", fields: [parent_id], references: [id])
  children             Account[]    @relation("AccountHierarchy")
  is_group             Boolean      @default(false)  // group accounts cannot have journal lines

  // Control account / sub-ledger linkage
  is_control_account   Boolean      @default(false)
  bp_type_id           String?      @db.Uuid         // required when is_control_account = true
  bp_type              BPType?      @relation(fields: [bp_type_id], references: [id])

  // Opening balance
  opening_balance      Decimal?     @db.Decimal(15, 2)
  opening_balance_type BalanceType?
  opening_balance_date DateTime?    @db.Date

  is_system            Boolean      @default(false)  // seeded accounts — cannot be deleted
  is_active            Boolean      @default(true)
  sort_order           Int          @default(0) @db.SmallInt
  created_at           DateTime     @default(now()) @db.Timestamptz
  updated_at           DateTime     @updatedAt @db.Timestamptz

  association          Association  @relation(fields: [association_id], references: [id], onDelete: Cascade)
  journal_lines        JournalLine[]

  @@unique([association_id, code])
  @@index([association_id, type])
  @@index([association_id, parent_id])
  @@map("accounts")
}

// ── Journal Entry ─────────────────────────────────────────────────────────────

model JournalEntry {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id      String             @db.Uuid
  reference_code      String             @db.VarChar(25)  // e.g. RV-2024-25-0001
  voucher_type        VoucherType
  financial_year      String             @db.VarChar(7)   // e.g. "2024-25"
  entry_date          DateTime           @db.Date
  narration           String             @db.VarChar(255)
  status              JournalStatus      @default(DRAFT)
  source              JournalEntrySource @default(MANUAL)

  // Link back to the originating transaction (dues, expense, payment etc.)
  reference_type      String?            @db.VarChar(50)
  reference_id        String?            @db.Uuid

  // Workflow
  created_by_id       String?            @db.Uuid
  created_by          User?              @relation("JECreatedBy", fields: [created_by_id], references: [id])
  posted_by_id        String?            @db.Uuid
  posted_by           User?              @relation("JEPostedBy", fields: [posted_by_id], references: [id])
  posted_at           DateTime?          @db.Timestamptz
  cancelled_by_id     String?            @db.Uuid
  cancelled_by        User?              @relation("JECancelledBy", fields: [cancelled_by_id], references: [id])
  cancelled_at        DateTime?          @db.Timestamptz
  cancellation_reason String?            @db.Text

  created_at          DateTime           @default(now()) @db.Timestamptz
  updated_at          DateTime           @updatedAt @db.Timestamptz

  association         Association        @relation(fields: [association_id], references: [id], onDelete: Cascade)
  lines               JournalLine[]

  @@unique([association_id, reference_code])
  @@index([association_id, voucher_type])
  @@index([association_id, entry_date(sort: Desc)])
  @@index([association_id, financial_year])
  @@index([association_id, status])
  @@map("journal_entries")
}

// ── Journal Line ──────────────────────────────────────────────────────────────

model JournalLine {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journal_entry_id    String           @db.Uuid
  account_id          String           @db.Uuid
  business_partner_id String?          @db.Uuid  // required when account is a control account
  debit               Decimal          @default(0) @db.Decimal(15, 2)
  credit              Decimal          @default(0) @db.Decimal(15, 2)
  narration           String?          @db.VarChar(255)

  journal_entry       JournalEntry     @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade)
  account             Account          @relation(fields: [account_id], references: [id])
  business_partner    BusinessPartner? @relation(fields: [business_partner_id], references: [id])

  @@index([journal_entry_id])
  @@index([account_id])
  @@index([business_partner_id])
  @@map("journal_lines")
}

model MenuGroupConfig {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String   @db.VarChar(50)
  role       String   @db.VarChar(50)
  enabled    Boolean  @default(true)
  updated_at DateTime @updatedAt @db.Timestamptz

  @@unique([group_id, role])
  @@map("menu_group_config")
}

model MobileConfig {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id        String      @unique @db.Uuid
  association           Association @relation(fields: [association_id], references: [id])

  // Feature flags — which screens appear in the mobile app
  feature_bills         Boolean     @default(true)
  feature_announcements Boolean     @default(true)
  feature_complaints    Boolean     @default(true)
  feature_visitors      Boolean     @default(true)

  // Accounting feature flags (Gold mobile only)
  feature_journal       Boolean     @default(true)
  feature_ledger        Boolean     @default(true)
  feature_pnl           Boolean     @default(true)
  feature_balance_sheet Boolean     @default(true)
  feature_coa           Boolean     @default(true)
  feature_fy_closure    Boolean     @default(true)

  // Push notification categories
  push_dues_reminder    Boolean     @default(true)
  push_announcements    Boolean     @default(true)
  push_visitor_alerts   Boolean     @default(true)

  // Login options
  login_mpin_enabled    Boolean     @default(true)
  login_biometric       Boolean     @default(false)
  login_otp_only        Boolean     @default(false)

  // Per-menu-item visibility + permissions (JSON map of itemId → {enabled, can_post})
  menu_items            Json?

  // Branding
  app_name              String?     @db.VarChar(100)
  theme_color           String?     @db.VarChar(7)
  logo_url              String?     @db.Text

  created_at            DateTime    @default(now()) @db.Timestamptz
  updated_at            DateTime    @updatedAt @db.Timestamptz

  @@map("mobile_config")
}

// ── Financial Year Closure ─────────────────────────────────────────────────────

model FinancialYearClose {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  association_id     String      @db.Uuid
  association        Association @relation(fields: [association_id], references: [id], onDelete: Cascade)
  financial_year     String      @db.VarChar(7)   // e.g. "2024-25"
  status             String      @default("CLOSED") @db.VarChar(20)  // CLOSED | REOPENED
  net_surplus        Decimal     @db.Decimal(15, 2)
  closing_entry_id   String?     @db.VarChar(30)   // JE reference_code of closing entry (e.g. "JV-2025-26-0012")
  notes              String?     @db.Text
  closed_by_id       String?     @db.Uuid
  closed_by          User?       @relation("FYClosedBy", fields: [closed_by_id], references: [id])
  closed_at          DateTime    @default(now()) @db.Timestamptz
  reopened_by_id     String?     @db.Uuid
  reopened_by        User?       @relation("FYReopenedBy", fields: [reopened_by_id], references: [id])
  reopened_at        DateTime?   @db.Timestamptz

  @@unique([association_id, financial_year])
  @@map("financial_year_closes")
}
