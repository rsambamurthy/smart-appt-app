   const openNewForm = () => {
     setSelectedId(null);
@@ -215,7 +241,7 @@ export default function JournalEntriesPage() {
     setNarration('');
     setVoucherClass('BANK');
     setDirection('RECEIPT');
-    setMoneyAccount('');
+    setMoneyAccount(defaultMoneyAccountFor('BANK'));
